samples/showcase/custom-ca-certs/custom-ca-certs

# Ephemeral melange signing keys (generated per-build, never committed)
melange.rsa
melange.rsa.pub

# Local build/dependency artifacts generated by sample toolchains (regenerated
# by their own build step — dotnet build, gradle, npm install, composer
# install, pip — never committed). No existing tracked path collides with any
# of these names (verified against `git ls-tree -r main`); deliberately not
# including a bare `public/` pattern since samples/web/custom-nginx/public/
# is real, tracked source.
obj/
.gradle/
build/
target/
node_modules/
__pycache__/
*.pyc
.venv/
venv/
samples/php/**/vendor/
samples/php/**/composer.lock
samples/php/**/.env

